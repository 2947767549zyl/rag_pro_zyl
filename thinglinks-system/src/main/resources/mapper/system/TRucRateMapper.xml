<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.thinglinks.system.mapper.TRucRateMapper">
    
    <resultMap type="TRucRate" id="TRucRateResult">
        <result property="id"    column="id"    />
        <result property="roadLevel"    column="road_level"    />
        <result property="unitMileage"    column="unit_mileage"    />
        <result property="unitPrice"    column="unit_price"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTRucRateVo">
        select * from t_ruc_rate
    </sql>

    <select id="selectTRucRateList" parameterType="TRucRate" resultMap="TRucRateResult">
        <include refid="selectTRucRateVo"/>
        <where>  
            <if test="roadLevel != null  and roadLevel != ''"> and road_level = #{roadLevel}</if>
            <if test="unitMileage != null "> and unit_mileage = #{unitMileage}</if>
            <if test="unitPrice != null "> and unit_price = #{unitPrice}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectTRucRateById" parameterType="Long" resultMap="TRucRateResult">
        <include refid="selectTRucRateVo"/>
        where id = #{id}
    </select>

    <insert id="insertTRucRate" parameterType="TRucRate" useGeneratedKeys="true" keyProperty="id">
        insert into t_ruc_rate
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roadLevel != null">road_level,</if>
            <if test="unitMileage != null">unit_mileage,</if>
            <if test="unitPrice != null">unit_price,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roadLevel != null">#{roadLevel},</if>
            <if test="unitMileage != null">#{unitMileage},</if>
            <if test="unitPrice != null">#{unitPrice},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTRucRate" parameterType="TRucRate">
        update t_ruc_rate
        <trim prefix="SET" suffixOverrides=",">
            <if test="roadLevel != null">road_level = #{roadLevel},</if>
            <if test="unitMileage != null">unit_mileage = #{unitMileage},</if>
            <if test="unitPrice != null">unit_price = #{unitPrice},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTRucRateById" parameterType="Long">
        delete from t_ruc_rate where id = #{id}
    </delete>

    <delete id="deleteTRucRateByIds" parameterType="String">
        delete from t_ruc_rate where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>